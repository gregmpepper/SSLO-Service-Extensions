## SSL Orchestrator Service Extension - Advanced Blocking Pages
## Version: 1.0
## Date: 2026 Sept 10
## Author: Greg Pepper, F5 Networks

proc GEN_BLOCK_PAGE { msg } {
  # Option 1: Serve a static HTML page directly from F5 [3]
        HTTP::respond 200 content \
          "<html><head><title>Access Denied - $msg</title></head><body><h1>Access Denied</h1><p>This content has been blocked by the Ministry of Information Technology.</p><p>Reference ID: MOIT-BLOCK-12345</p></body></html>" \
          "Content-Type" "text/html"
        # Option 2: Redirect to a specific blocking page for this agency [3, 4]
        # HTTP::redirect "http://blockpage.example.com/moit_blocked.html"
}

when HTTP_REQUEST {
  # Construct the full URL (lowercase for case-insensitive matching)
  set full_url [string tolower "[HTTP::host][HTTP::uri]"]

  # Check if the full_url exists in the external data group and retrieve its value (the agency)
  # The data group name should match the one you created, e.g., 'dg_blocklist_by_agency'
  set matched_agency [class match -value $full_url contains dg_blocklist_by_agency]

  # If a match is found (i.e., $matched_agency is not empty)
  if { $matched_agency ne "" } {
    log local0. "Blocked URL: $full_url requested by agency: $matched_agency"
    call GEN_BLOCK_PAGE ${matched_agency}
    event disable all
  }

}